{
  "schemaVersion": 1,
  "requireApps": [
    1
  ],
  "steps": [
    {
      "name": "native-install",
      "events": [
        {
          "kind": "pointer",
          "x": 1140,
          "y": 12
        },
        {
          "kind": "button",
          "button": "left",
          "down": true
        },
        {
          "kind": "button",
          "button": "left",
          "down": false
        }
      ],
      "expect": {
        "storagePrompt": {
          "mode": 16,
          "packageId": "dev.ming.install-demo",
          "version": "1.0.0",
          "hasAllow": true
        },
        "rootAdvance": true,
        "storagePromptPresented": true
      }
    },
    {
      "name": "allow-install",
      "events": [
        {
          "kind": "pointer",
          "x": 880,
          "y": 478
        },
        {
          "kind": "button",
          "button": "left",
          "down": true
        },
        {
          "kind": "button",
          "button": "left",
          "down": false
        }
      ],
      "expect": {
        "storagePrompt": null
      }
    },
    {
      "name": "new-app-running",
      "events": [
        {
          "kind": "pointer",
          "x": 680,
          "y": 770
        }
      ],
      "expect": {
        "apps": [
          {
            "app": 2,
            "generation": 1,
            "state": "running"
          }
        ]
      }
    },
    {
      "name": "power-off-after-both-ready",
      "requireApps": [
        1,
        2
      ],
      "events": [
        {
          "kind": "pointer",
          "x": 1250,
          "y": 12
        },
        {
          "kind": "button",
          "button": "left",
          "down": true
        },
        {
          "kind": "button",
          "button": "left",
          "down": false
        }
      ],
      "expect": {
        "phase": "stopped"
      }
    }
  ]
}
